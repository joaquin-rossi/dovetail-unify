cabal-version:      3.14
name:               dovetail-unify
version:            0.1.0.0
synopsis:           Syntactic unification and anti-unification of first-order terms
description:
    A small library for first-order terms: most general unifiers,
    least general generalizations, substitutions, and a parser for
    Prolog-style terms and equations.
homepage:           https://github.com/joaquin-rossi/dovetail-unify
bug-reports:        https://github.com/joaquin-rossi/dovetail-unify/issues
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Joaquín Rossi
maintainer:         joaquin@joaquinrossi.net
copyright:          2026 Joaquín Rossi
category:           Math
build-type:         Simple
tested-with:        GHC ==9.10.3 || ==9.12.2 || ==9.14.1
extra-doc-files:
    README.md

source-repository head
    type:     git
    location: https://github.com/joaquin-rossi/dovetail-unify.git

common extensions
    default-language: GHC2024

common ghc-options
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wredundant-constraints

common rts-options
    ghc-options: -rtsopts
    if !arch(wasm32)
        ghc-options: -threaded "-with-rtsopts=-N"

library
    import:           extensions
    import:           ghc-options
    exposed-modules:  Dovetail
                      Dovetail.Parser
                      Dovetail.Parser.Lexer
                      Dovetail.Pretty
    build-depends:    base >=4.20 && <4.23,
                      containers >=0.7 && <0.9,
                      parsec ^>=3.1.18
    hs-source-dirs:   src

test-suite dovetail-unify-test
    import:           extensions
    import:           ghc-options
    import:           rts-options
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    AntiUnifySpec
                      MatchSpec
                      ParserSpec
                      PrettySpec
                      SubstSpec
                      Support.Generators
                      Support.Terms
                      TermSpec
                      UnifySpec
    build-depends:    base >=4.20 && <4.23,
                      containers >=0.7 && <0.9,
                      hspec ^>=2.11,
                      QuickCheck >=2.14 && <2.20,
                      dovetail-unify
